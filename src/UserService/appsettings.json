{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  /*
   For Connection Strings: Demonstration credentials only. Production credentials would be supplied through secure configuration and would not be committed to source control.
   But we want to remain transparent for this demonstration. Normally we would use a Secret-Management system and keep the credentials out of source control entirely.
  */
  "ConnectionStrings": {
    "UserServiceDatabase_ReadAccess": "Server=localhost;Port=3401;Database=UserService;User=ReadUser;Password=password;",
    "UserServiceDatabase_WriteAccess": "Server=localhost;Port=3401;Database=UserService;User=WriteUser;Password=password;",
    "UserServiceDatabase_ReadWriteAccess": "Server=localhost;Port=3401;Database=UserService;User=ReadWriteUser;Password=password;"
  },
  /*
    For Jason Web Tokens: we will be making this for demonstration purposes only, as such the Key will be simple
    and will not be withheld. The User Service will be our acting issuer with the rest of the PortfolioWork as the Audience.
    We will be using a 60 minute expiration time for all tokens.
  */
  "JWT": {
    "Issuer": "PortfolioWork.UserService",
    "Audience": "PortfolioWork",
    "Key": "DEMONSTRATION-KEY-FOR-MATLOCK-WHITE-PORTFOLIO-WORK",
    "ExpirationMinutes": 60
  },
  "AllowedHosts": "*"
}
